{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://baths-possibilities-helmet-costumes.trycloudflare.com/api/$1"
    },
    {
      "source": "/plane.glb",
      "destination": "/plane.glb"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
